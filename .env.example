SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=mysql+pymysql://church:change-this-password@127.0.0.1:3306/rich_in_glory?charset=utf8mb4
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:5000
# Production: APP_ENV=production, HTTPS origin, and shared redis:// storage.
RATELIMIT_STORAGE_URI=memory://
UPLOAD_FOLDER=uploads

# Vercel production: set MEDIA_STORAGE=vercel_blob and connect a public Blob store.
MEDIA_STORAGE=local
# BLOB_READ_WRITE_TOKEN is supplied securely by Vercel, never committed.
# MYSQL_SSL_CA: optional trusted CA PEM for your hosted MySQL service.
